rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'fullName', 'role']) &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 64 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 128 &&
             data.role is string && data.role.size() <= 32;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['employeeId', 'fullName']) &&
             data.employeeId is string && data.employeeId.size() <= 32 &&
             data.fullName is string && data.fullName.size() <= 128;
    }

    function isValidNetData(data) {
      return data.keys().hasAll(['model', 'code']) &&
             data.model is string && data.model.size() <= 128 &&
             data.code is string && data.code.size() <= 128;
    }

    function isValidImportRecord(data) {
      return data.keys().hasAll(['model', 'code', 'lotNo', 'quantity']) &&
             data.model is string && data.model.size() <= 128 &&
             data.code is string && data.code.size() <= 128 &&
             data.lotNo is string && data.lotNo.size() <= 128 &&
             data.quantity is number;
    }

    function isValidProductionHistory(data) {
      return data.keys().hasAll(['model', 'code', 'lotNo']) &&
             data.model is string && data.model.size() <= 128 &&
             data.code is string && data.code.size() <= 128 &&
             data.lotNo is string && data.lotNo.size() <= 128;
    }

    function isValidQrLoginUserMap(u) {
      return u is map &&
             u.keys().hasAll(['username', 'fullName', 'role']) &&
             u.keys().hasOnly(['username', 'fullName', 'role', 'employeeId', 'department']) &&
             u.username is string && u.username.size() >= 1 && u.username.size() <= 64 &&
             u.fullName is string && u.fullName.size() >= 1 && u.fullName.size() <= 128 &&
             u.role == 'admin' &&
             (!('employeeId' in u) || (u.employeeId is string && u.employeeId.size() <= 32)) &&
             (!('department' in u) || (u.department is string && u.department.size() <= 64));
    }

    function isValidQrLoginSessionCreate(data, sessionId) {
      return data.keys().hasAll(['sessionId', 'status', 'createdAt', 'expiresAt']) &&
             data.keys().hasOnly(['sessionId', 'status', 'deviceLabel', 'createdAt', 'expiresAt']) &&
             data.sessionId == sessionId &&
             data.status == 'PENDING' &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.expiresAt is number &&
             (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 128));
    }

    function isValidQrLoginSessionUpdate(data, prev) {
      return data.sessionId == prev.sessionId &&
             data.createdAt == prev.createdAt &&
             data.expiresAt == prev.expiresAt &&
             prev.status != 'CONSUMED' &&
             (
               (
                 prev.status == 'PENDING' &&
                 data.status == 'APPROVED' &&
                 data.diff(prev).affectedKeys().hasOnly(['status', 'targetAction', 'approvedBy', 'approvedAt']) &&
                 data.targetAction in ['LOGIN_QRCODE', 'LOGOUT_TO_LOGIN'] &&
                 data.approvedAt is string && data.approvedAt.size() <= 64 &&
                 isValidQrLoginUserMap(data.approvedBy)
               ) ||
               (
                 prev.status == 'APPROVED' &&
                 data.status == 'CONSUMED' &&
                 data.diff(prev).affectedKeys().hasOnly(['status'])
               ) ||
               (
                 prev.status == 'PENDING' &&
                 data.status == 'EXPIRED' &&
                 data.diff(prev).affectedKeys().hasOnly(['status'])
               )
             );
    }

    // 2. Collection Rules

    // Connection Test Document
    match /test/connection {
      allow read, write: if true;
    }

    // Factory State Synchronization Document
    match /app_state/{docId} {
      allow read, write: if true;
    }

    // User Accounts
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Staff Records
    match /staff/{staffId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Net Data
    match /net_data/{dataId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Import Records
    match /imported_records/{recordId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Production History
    match /production_history/{historyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Remote QR Login Sessions (Zalo-style admin QR login / exit)
    match /qr_login_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if false;
      allow create: if isValidId(sessionId) && isValidQrLoginSessionCreate(incoming(), sessionId);
      allow update: if isValidId(sessionId) && isValidQrLoginSessionUpdate(incoming(), existing());
      allow delete: if false;
    }
  }
}
