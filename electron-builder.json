{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.newprotecvina.hrm",
  "productName": "Newprotec Vina HRM",
  "npmRebuild": false,
  "directories": {
    "app": "dist-electron-app",
    "output": "release"
  },
  "files": [
    "**/*"
  ],
  "win": {
    "icon": "icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "Newprotec-Vina-HRM-Setup-${version}-win-${arch}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "portable": {
    "artifactName": "Newprotec-Vina-HRM-Portable-${version}-win-${arch}.${ext}"
  },
  "mac": {
    "icon": "icon.png",
    "category": "public.app-category.business",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ]
  },
  "dmg": {
    "artifactName": "Newprotec-Vina-HRM-${version}-mac-${arch}.${ext}"
  }
}
